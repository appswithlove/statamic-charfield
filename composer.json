{
  "name": "appswithlove/statamic-charfield",
  "license": "MIT",
  "type": "statamic-addon",
  "description": "Character counting field for statamic",
  "autoload": {
    "psr-4": {
      "AppsWithLove\\Statamic\\CharField\\": "src"
    }
  },
  "authors": [
    {
      "name": "Rémy Böhler"
    }
  ],
  "require": {
    "statamic/cms": "^3.0 || ^4.0 || ^5.0"
  },
  "extra": {
    "statamic": {
      "name": "CharField",
      "description": "Character counting field"
    },
    "laravel": {
      "providers": [
        "AppsWithLove\\Statamic\\CharField\\ServiceProvider"
      ]
    }
  },
  "require-dev": {
    "laravel/pint": "^1.18"
  },
  "config": {
    "allow-plugins": {
      "pixelfear/composer-dist-plugin": true
    }
  }
}
